{
  "name": "playwright-demo-web-shop-q2",
  "version": "1.0.0",
  "type": "module",
  "description": "Playwright Automation Suite - Q2: Register and Add to Cart",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "report:html": "npx playwright show-report --port 9324",
    "allure:generate": "npx allure-commandline generate allure-results --clean -o allure-report",
    "allure:open": "npx allure-commandline open allure-report",
    "test:all-reports": "npm run test && npm run allure:generate && npm run allure:open"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "allure-commandline": "^2.29.0",
    "allure-playwright": "^2.13.0"
  }
}